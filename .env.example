# Backend settings. For production, set this to the deployed frontend origin(s).
EARTH_PULSE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional OpenAI-compatible research-assistant configuration. Keep this key
# server-side; never prefix it with NEXT_PUBLIC_.
EARTH_PULSE_LLM_API_URL=https://api.openai.com/v1/chat/completions
EARTH_PULSE_LLM_API_KEY=
EARTH_PULSE_LLM_MODEL=gpt-4o-mini
